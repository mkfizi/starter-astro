---
import BaseLayout from '../BaseLayout.astro';
const { frontmatter } = Astro.props;
const { 
    title = frontmatter?.title,
    date = frontmatter?.date,
    description = frontmatter?.description,
    tags = frontmatter?.tags,
	page = 'Blog',
    headings = getHeadings(),
} = Astro.props;
---

<BaseLayout title={title} page={page} description={description}>
     <div class="max-w-4xl">
        <div class="space-y-2">
            <h1 class="font-extrabold text-black dark:text-white text-4xl sm:text-5xl lg:text-6xl">{title}</h1>
            <p class="text-neutral-800 dark:text-neutral-200 text-sm">Published on: {date?.toString().slice(0,10)}</p>
        </div>
        <!-- Table of Contents -->
        {headings.length > 0 && (
            <nav class="space-y-4 mt-8">
				<p class="font-medium text-neutral-800 dark:text-neutral-200 text-base">Table of Contents</p>
                <div class="p-4 border border-neutral-200 dark:border-neutral-800 rounded w-fit">
                    <ul class="space-y-2 ml-4 text-neutral-800 dark:marker:text-neutral-200 dark:text-neutral-200 marker:text-neutral-800 text-smspace-y-2 leading-0 list-disc">
                        {headings.map((heading: any) => (
                            <li class={
                                heading.depth === 1 ? 'ml-0' :
                                heading.depth === 2 ? 'ml-4' :
                                heading.depth === 3 ? 'ml-8' : 'ml-0'
                            }>
                                <a href={`#${heading.slug}`} class="font-medium text-neutral-500 hover:dark:text-white hover:text-black focus:dark:text-white focus:text-black visited:text-neutral-700 dark:text-neutral-400 dark:visited:text-neutral-200 text-sm cursor-pointer">{heading.text}</a>
                            </li>
                        ))}
                    </ul>
                </div>
            </nav>
        )}
        <!-- END Table of Contents -->
        <!-- Markdown Content -->
        <div class="space-y-8 mt-8 markdown">
            <slot/>
        </div>
        <!-- END Markdown Content -->
        <!-- Tags -->
        <div class="space-y-4 mt-16">
            <p class="font-medium text-neutral-800 dark:text-neutral-200 text-base">Tags:</p>
            {tags && tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                    {tags.map((tag: string) => (
                        <a href={`/blog/tags/${tag.toLowerCase()}`} class="inline-block bg-neutral-200 hover:bg-neutral-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 disabled:opacity-60 px-2 py-px rounded w-max text-black dark:text-white text-xs cursor-pointer">{tag.charAt(0).toUpperCase() + tag.slice(1)}</a>
                    ))}
                </div>
            )}
        </div>
        <!-- END Tags -->
        <div class="mt-8">
            <a href="/blog" class="font-medium text-neutral-500 hover:dark:text-white hover:text-black focus:dark:text-white focus:text-black visited:text-neutral-700 dark:text-neutral-400 dark:visited:text-neutral-200 text-sm cursor-pointer">&larr; Back</a>
        </div>
    </div>
</BaseLayout>