---
const { 
    href = '', 
    class: className = '',
    {...rest}
} = Astro.props;
---

<a href={href ?? '#'} class={`font-medium text-neutral-500 dark:text-neutral-400 dark:visited:text-neutral-200 dark:hover:text-white dark:focus:text-white hover:text-black focus:text-black visited:text-neutral-700 text-sm cursor-pointer ${className}`} {...rest}>
	<slot />
</a>