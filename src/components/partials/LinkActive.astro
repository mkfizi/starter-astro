---
const { 
    href = '', 
    class: className = '',
    target = '',  
} = Astro.props;
---

<a href={href ?? '#'} class={`font-medium text-black dark:text-white dark:hover:text-neutral-200 dark:focus:text-neutral-200 hover:text-neutral-700 focus:text-neutral-700 text-sm cursor-pointer ${className}`} target={target || undefined}>
	<slot />
</a>